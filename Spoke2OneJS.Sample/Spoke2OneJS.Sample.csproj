<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real Spoke sources (engine-free assemblies) from the sibling checkout. -->
    <Compile Include="..\..\Spoke\Runtime\Spoke.Runtime\**\*.cs;..\..\Spoke\Runtime\Spoke.Reactive\**\*.cs" LinkBase="Spoke" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spoke2OneJS.Generators\Spoke2OneJS.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
